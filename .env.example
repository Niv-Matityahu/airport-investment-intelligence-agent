# Copy to .env and fill in, or `export` these in your shell.
# Get a key at https://console.anthropic.com/ -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override. Default is claude-opus-4-8 (best reasoning).
# claude-sonnet-5 is a cheaper/faster alternative for demos.
# ANTHROPIC_MODEL=claude-sonnet-5
