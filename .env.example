# Copy to .env and fill in, or `export` these in your shell.
# The agent works with EITHER Anthropic Claude or Google Gemini.
# Provider is auto-selected: if a Gemini key is set and no Anthropic key, it uses
# Gemini. Or force it explicitly:
# LLM_PROVIDER=gemini        # or: anthropic

# --- Option A: Google Gemini ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # default
# GEMINI_THINKING_BUDGET=0               # bump to 1024 for gemini-3.x models

# --- Option B: Anthropic Claude ---
# Get a key at https://console.anthropic.com/ -> API keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # or claude-sonnet-5 (cheaper/faster)
